$ORIGIN 193.in-addr.arpa.
$TTL 86400
@                       IN SOA  ns.ripe.net. dns.ripe.net. (
                                2024010101 ; serial
                                3600       ; refresh
                                1800       ; retry
                                604800     ; expire
                                86400 )    ; minimum
                        NS      ns.ripe.net.
                        NS      ns3.nic.fr.
                        RRSIG   NS 8 3 86400 20300101000000 20240101000000 12345 193.in-addr.arpa. fake=
0.0                     NS      ns.example.net.
0.0                     NS      ns2.example.net.
0.0                     DS      12345 8 2 ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789ABCDEF0123456789
128/25.1.0              CNAME   128.1.0.193.in-addr.arpa.customer.example.net.
